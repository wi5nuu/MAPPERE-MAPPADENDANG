  font-size: 0.95rem;
  line-height: 1.8;
  color: var(--ink-3);
}

.detail-list { border-top: 1px solid rgba(28,23,18,0.1); }
.detail-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.85rem 0;
  border-bottom: 1px solid rgba(28,23,18,0.07);
}
.detail-key {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  flex-shrink: 0;
}
