  object-fit: cover;
  filter: brightness(0.97) contrast(1.03);
  transition: transform 0.7s ease, filter 0.7s;
  display: block;
}
.mtx-media:hover .img-wrap img {
  transform: scale(1.03);
  filter: brightness(1) contrast(1.05);
}
