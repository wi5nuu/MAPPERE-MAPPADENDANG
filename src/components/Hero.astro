<header id="hero">
  <div class="hero-bg" id="heroBg"></div>
  <div class="hero-overlay"></div>
  <canvas id="particleCanvas"></canvas>

  <div class="hero-content">
    <p class="hero-eyebrow">Tradisi Tahunan · Calodo, Cenrana · Sulawesi Selatan</p>
    <h1 class="hero-title">
      <span class="tl tl-1">Pesta</span>
      <span class="tl tl-2 tl-gold">Panen</span>
      <span class="tl tl-3 tl-thin">Calodo Cenrana</span>
    </h1>
    <p class="hero-desc">
      Wujud syukur atas hasil padi dan kebun yang diturunkan leluhur,<br />
      dirayakan setiap tahun dengan penuh khidmat dan kegembiraan.
    </p>
    <div class="hero-pills">
      <span class="pill">09.00 – 15.00 WITA</span>
      <span class="pill-div">·</span>
      <span class="pill">Setiap Tahun</span>
      <span class="pill-div">·</span>
      <span class="pill">Bugis Bone</span>
    </div>
    <a href="#rundown" class="cta-btn">
      <span>Lihat Rangkaian Acara</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>

  <div class="hero-scroll-ind">
    <div class="scroll-track"><div class="scroll-thumb"></div></div>
    <span>Gulir</span>
  </div>

  <div class="hero-infobar">
    <div class="ib-item">
      <span class="ib-label">Lokasi</span>
      <span class="ib-val">Calodo, Cenrana, Bone</span>
    </div>
    <div class="ib-sep"></div>
    <div class="ib-item">
      <span class="ib-label">Durasi</span>
      <span class="ib-val">6 Jam Penuh</span>
    </div>
    <div class="ib-sep"></div>
    <div class="ib-item">
      <span class="ib-label">Tradisi</span>
      <span class="ib-val">Bugis · Pesta Pascapanen</span>
    </div>
    <div class="ib-sep"></div>
    <div class="ib-item">
      <span class="ib-label">Kegiatan Utama</span>
      <span class="ib-val">Mappadendang · Mappere · Olahraga</span>
    </div>
  </div>
</header>

<script>
/* ---- Canvas Particle System ---- */
(function () {
  const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d')!;
  let W = 0, H = 0;

  function resize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  class Particle {
    x = 0; y = 0; size = 0; speedY = 0; speedX = 0;
    alpha = 0; fadeIn = 0; life = 0; maxLife = 0; color = '';
    constructor() { this.reset(); }
    reset() {
      this.x = Math.random() * W;
      this.y = H + Math.random() * 60;
      this.size = 1 + Math.random() * 2;
      this.speedY = 0.3 + Math.random() * 0.7;
      this.speedX = (Math.random() - 0.5) * 0.4;
      this.alpha = 0;
      this.fadeIn = 0.008 + Math.random() * 0.008;
      this.life = 0;
      this.maxLife = 300 + Math.random() * 400;
      const hue = 35 + Math.random() * 20;
      const lit = 55 + Math.random() * 25;
      this.color = `hsl(${hue},70%,${lit}%)`;
    }
    update() {
      this.y -= this.speedY;
      this.x += this.speedX;
      this.life++;
      if (this.life < 60) this.alpha = Math.min(this.alpha + this.fadeIn, 0.65);
      if (this.life > this.maxLife - 80) this.alpha -= 0.012;
      if (this.alpha <= 0 || this.y < -20) this.reset();
    }
    draw() {
      ctx.save();
      ctx.globalAlpha = Math.max(0, this.alpha);
      ctx.fillStyle = this.color;
      ctx.shadowBlur = 6;
      ctx.shadowColor = this.color;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }

  const particles: Particle[] = [];
  for (let i = 0; i < 55; i++) {
    const p = new Particle();
    p.y = Math.random() * H;
    p.life = Math.random() * p.maxLife;
    particles.push(p);
  }

  function animate() {
    ctx.clearRect(0, 0, W, H);
    particles.forEach(p => { p.update(); p.draw(); });
    requestAnimationFrame(animate);
  }
  animate();

  /* Parallax */
  const heroBg = document.getElementById('heroBg')!;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y < window.innerHeight) heroBg.style.transform = `scale(1) translateY(${y * 0.25}px)`;
  }, { passive: true });
})();
</script>

<style>
#hero {
  position: relative;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: #fff;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: url('/img/mappadendang.jpg') center/cover no-repeat;
  transform: scale(1.1);
  animation: bgZoom 18s ease-out forwards;
  will-change: transform;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right, rgba(16,14,11,0.85) 0%, rgba(16,14,11,0.4) 100%),
    linear-gradient(to top, rgba(16,14,11,0.85) 0%, transparent 45%);
}
#particleCanvas {
  position: absolute;
  inset: 0; width: 100%; height: 100%;
  pointer-events: none; z-index: 1;
}
.hero-content {
  position: relative;
  z-index: 2;
  max-width: 820px;
  padding: clamp(5rem,10vw,9rem) clamp(1.5rem,5vw,3rem) 10rem;
}
.hero-eyebrow {
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.45);
  margin-bottom: 1.5rem;
  animation: fadeUp 1s ease 0.15s both;
}
.hero-title {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  margin-bottom: 1.75rem;
}
.tl {
  display: block;
  font-family: var(--ff-serif);
  font-size: clamp(3.5rem,8vw,7rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.01em;
  animation: fadeUp 1s ease both;
}
.tl-1 { animation-delay: 0.3s; }
.tl-2 { animation-delay: 0.45s; }
.tl-3 { animation-delay: 0.6s; }
.tl-gold { color: var(--gold-lt); font-style: italic; }
.tl-thin {
  font-size: clamp(1.6rem,3.5vw,2.8rem);
  font-weight: 400;
  color: rgba(255,255,255,0.5);
  font-style: normal;
  letter-spacing: 0.04em;
}
.hero-desc {
  font-size: clamp(0.95rem,1.8vw,1.1rem);
  line-height: 1.75;
  color: rgba(255,255,255,0.6);
  margin-bottom: 2rem;
  max-width: 520px;
  animation: fadeUp 1s ease 0.75s both;
}
.hero-pills {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
  animation: fadeUp 1s ease 0.9s both;
}
.pill {
  font-size: 0.73rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  border: 1px solid rgba(255,255,255,0.18);
  padding: 0.35rem 0.85rem;
  border-radius: 2px;
}
.pill-div { color: rgba(255,255,255,0.2); }
.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background: var(--gold);
  color: var(--ink);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.9rem 1.8rem;
  border-radius: 2px;
  transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
  animation: fadeUp 1s ease 1.05s both;
  box-shadow: 0 8px 32px rgba(201,151,74,0.3);
}
.cta-btn:hover {
  background: var(--gold-lt);
  transform: translateY(-2px);
  box-shadow: 0 14px 40px rgba(201,151,74,0.4);
}
.cta-btn svg { transition: transform 0.3s; }
.cta-btn:hover svg { transform: translateX(4px); }

/* Scroll indicator */
.hero-scroll-ind {
  position: absolute;
  bottom: 5.5rem; left: clamp(1.5rem,5vw,3rem);
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  animation: fadeUp 1s ease 1.3s both;
}
.hero-scroll-ind span {
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  writing-mode: vertical-lr;
}
.scroll-track {
  width: 1px; height: 50px;
  background: rgba(255,255,255,0.15);
  position: relative; overflow: hidden;
}
.scroll-thumb {
  position: absolute;
  top: -100%; left: 0;
  width: 1px; height: 50%;
  background: var(--gold);
  animation: scrollAnim 2s ease-in-out infinite;
}

/* Info bar */
.hero-infobar {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  z-index: 3;
  display: flex;
  align-items: stretch;
  border-top: 1px solid rgba(255,255,255,0.08);
  background: rgba(16,14,11,0.6);
  backdrop-filter: blur(12px);
  animation: fadeUp 1s ease 1.4s both;
}
.ib-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 1rem 1.5rem;
}
.ib-label {
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.3);
  margin-bottom: 0.25rem;
}
.ib-val { font-size: 0.82rem; color: rgba(255,255,255,0.75); }
.ib-sep { width: 1px; background: rgba(255,255,255,0.08); margin: 0.75rem 0; }

@keyframes bgZoom { to { transform: scale(1); } }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: none; }
}
@keyframes scrollAnim {
  0%  { top: -100%; opacity: 1; }
  80% { top: 100%; opacity: 1; }
  81% { opacity: 0; top: 100%; }
  82% { top: -100%; opacity: 0; }
  100%{ top: -100%; opacity: 0; }
}
@media (max-width: 768px) {
  .hero-infobar { display: none; }
}
</style>
