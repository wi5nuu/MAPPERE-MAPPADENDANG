---
import { Picture } from 'astro:assets';
import heroImg from '../assets/img/mappadendang.jpg';
---

<header id="hero" role="banner">
  <div class="hero-bg" id="heroBg">
    <Picture
      src={heroImg}
      alt=""
      widths={[640, 960, 1376]}
      sizes="100vw"
      formats={['webp']}
      quality={50}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-overlay"></div>
  <canvas id="particleCanvas" aria-hidden="true"></canvas>

  <div class="hero-content">
    <p class="hero-eyebrow">Tradisi Budaya Bugis · Calodo, Cenrana, Bone · Sulawesi Selatan</p>
    <h1 class="hero-title">
      <span class="tl tl-1">Pesta Panen</span>
      <span class="tl tl-2 tl-gold">Mappere &amp; Mappadendang</span>
      <span class="tl tl-3 tl-thin">Calodo Cenrana</span>
    </h1>
    <p class="hero-desc">
      Wujud rasa syukur masyarakat Bugis atas hasil panen padi, ikan, dan kebun,
      dirayakan setiap tahun dengan tradisi ayunan raksasa Mappere dan penumbukan gabah Mappadendang.
    </p>
    <div class="hero-pills">
      <span class="pill"><time datetime="2026-10-24">Sabtu, 24 Oktober 2026</time></span>
      <span class="pill-div">·</span>
      <span class="pill">Mulai 09.00 WITA</span>
      <span class="pill-div">·</span>
      <span class="pill">Kabupaten Bone, Sulsel</span>
    </div>
    <a href="#rundown" class="cta-btn">
      <span>Lihat Rangkaian Acara</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>

  <div class="hero-scroll-ind">
    <div class="scroll-track"><div class="scroll-thumb"></div></div>
    <span>Gulir</span>
  </div>

  <div class="hero-infobar">
    <div class="ib-item">
      <span class="ib-label">Lokasi</span>
      <span class="ib-val">Calodo, Cenrana, Bone</span>
    </div>
    <div class="ib-sep"></div>
    <div class="ib-item">
      <span class="ib-label">Durasi</span>
      <span class="ib-val">6 Jam Penuh</span>
    </div>
    <div class="ib-sep"></div>
    <div class="ib-item">
      <span class="ib-label">Tradisi</span>
      <span class="ib-val">Bugis · Pesta Pascapanen</span>
    </div>
    <div class="ib-sep"></div>
    <div class="ib-item">
      <span class="ib-label">Kegiatan Utama</span>
      <span class="ib-val">Mappadendang · Mappere · Olahraga</span>
    </div>
  </div>
</header>

<script>
/* ---- Ambient particles + parallax (skipped for reduced motion) ---- */
(function () {
  const hero   = document.getElementById('hero')!;
  const heroBg = document.getElementById('heroBg')!;
  const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement | null;
  if (!canvas || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const isSmall = matchMedia('(max-width: 768px)').matches;
  const COUNT = isSmall ? 22 : 45;
  let W = 0, H = 0;

  function resize() {
    W = canvas!.width  = hero.clientWidth;
    H = canvas!.height = hero.clientHeight;
  }

  type P = { x: number; y: number; r: number; vy: number; vx: number; a: number; life: number; max: number; c: string };
  function spawn(p: Partial<P> = {}, fresh = false): P {
    const max = 300 + Math.random() * 400;
    return Object.assign(p, {
      x: Math.random() * W,
      y: fresh ? Math.random() * H : H + Math.random() * 60,
      r: 1 + Math.random() * 2,
      vy: 0.3 + Math.random() * 0.7,
      vx: (Math.random() - 0.5) * 0.4,
      a: 0,
      life: fresh ? Math.random() * max : 0,
      max,
      c: `hsl(${35 + Math.random() * 20},70%,${55 + Math.random() * 25}%)`,
    }) as P;
  }

  let particles: P[] = [];
  let running = false;
  let raf = 0;

  function frame() {
    ctx!.clearRect(0, 0, W, H);
    for (const p of particles) {
      p.y -= p.vy; p.x += p.vx; p.life++;
      if (p.life < 60) p.a = Math.min(p.a + 0.012, 0.65);
      if (p.life > p.max - 80) p.a -= 0.012;
      if (p.a <= 0 && p.life > 60 || p.y < -20) { spawn(p); continue; }
      ctx!.fillStyle = p.c;
      ctx!.globalAlpha = Math.max(0, p.a) * 0.25;   // soft glow
      ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r * 3, 0, Math.PI * 2); ctx!.fill();
      ctx!.globalAlpha = Math.max(0, p.a);
      ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx!.fill();
    }
    raf = requestAnimationFrame(frame);
  }
  function start() { if (!running && !document.hidden) { running = true; raf = requestAnimationFrame(frame); } }
  function stop()  { running = false; cancelAnimationFrame(raf); }

  /* Start after first paint so particles never compete with the hero image */
  const boot = () => {
    resize();
    particles = Array.from({ length: COUNT }, () => spawn({}, true));
    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; visible ? start() : stop(); }).observe(hero);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : visible && start()));
    let rt = 0;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(resize, 150); }, { passive: true });
    start();
  };
  if ('requestIdleCallback' in window) requestIdleCallback(boot, { timeout: 1500 });
  else setTimeout(boot, 300);

  /* Parallax (desktop pointers only) */
  if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      if (y < window.innerHeight) heroBg.style.transform = `translate3d(0, ${y * 0.25}px, 0)`;
      ticking = false;
    });
  }, { passive: true });
})();
</script>

<style>
#hero {
  position: relative;
  min-height: 100dvh;
  display: flex;
  align-items: center;
  overflow: hidden;
  color: #fff;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: var(--dark);
  will-change: transform;
}
.hero-bg :global(picture),
.hero-bg :global(img) {
  display: block;
  width: 100%;
  height: 100%;
}
.hero-bg :global(img) {
  object-fit: cover;
  object-position: center;
  transform: scale(1.1);
  animation: bgZoom 18s ease-out forwards;
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(to right, rgba(16,14,11,0.85) 0%, rgba(16,14,11,0.4) 100%),
    linear-gradient(to top, rgba(16,14,11,0.85) 0%, transparent 45%);
}
#particleCanvas {
  position: absolute;
  inset: 0; width: 100%; height: 100%;
  pointer-events: none; z-index: 1;
}
.hero-content {
  position: relative;
  z-index: 2;
  max-width: 820px;
  padding: clamp(5rem,10vw,9rem) clamp(1.5rem,5vw,3rem) 10rem;
}
.hero-eyebrow {
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  margin-bottom: 1.5rem;
  animation: fadeUp 1s ease 0.15s both;
}
.hero-title {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
  margin-bottom: 1.75rem;
}
.tl {
  display: block;
  font-family: var(--ff-serif);
  font-size: clamp(3.5rem,8vw,7rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.01em;
  animation: fadeUp 1s ease both;
}
.tl-1 { animation-delay: 0.3s; }
.tl-2 { animation-delay: 0.45s; }
.tl-3 { animation-delay: 0.6s; }
.tl-gold { color: var(--gold-lt); font-style: italic; }
.tl-thin {
  font-size: clamp(1.6rem,3.5vw,2.8rem);
  font-weight: 400;
  color: rgba(255,255,255,0.6);
  font-style: normal;
  letter-spacing: 0.04em;
}
.hero-desc {
  font-size: clamp(0.95rem,1.8vw,1.1rem);
  line-height: 1.75;
  color: rgba(255,255,255,0.6);
  margin-bottom: 2rem;
  max-width: 520px;
  animation: fadeUp 1s ease 0.75s both;
}
.hero-pills {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
  animation: fadeUp 1s ease 0.9s both;
}
.pill {
  font-size: 0.73rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  border: 1px solid rgba(255,255,255,0.18);
  padding: 0.35rem 0.85rem;
  border-radius: 2px;
}
.pill-div { color: rgba(255,255,255,0.2); }
.cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background: var(--gold);
  color: var(--ink);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.9rem 1.8rem;
  border-radius: 2px;
  transition: background 0.3s, transform 0.3s, box-shadow 0.3s;
  animation: fadeUp 1s ease 1.05s both;
  box-shadow: 0 8px 32px rgba(201,151,74,0.3);
}
.cta-btn:hover {
  background: var(--gold-lt);
  transform: translateY(-2px);
  box-shadow: 0 14px 40px rgba(201,151,74,0.4);
}
.cta-btn svg { transition: transform 0.3s; }
.cta-btn:hover svg { transform: translateX(4px); }

/* Scroll indicator */
.hero-scroll-ind {
  position: absolute;
  bottom: 5.5rem; left: clamp(1.5rem,5vw,3rem);
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  animation: fadeUp 1s ease 1.3s both;
}
.hero-scroll-ind span {
  font-size: 0.62rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  writing-mode: vertical-lr;
}
.scroll-track {
  width: 1px; height: 50px;
  background: rgba(255,255,255,0.15);
  position: relative; overflow: hidden;
}
.scroll-thumb {
  position: absolute;
  top: -100%; left: 0;
  width: 1px; height: 50%;
  background: var(--gold);
  animation: scrollAnim 2s ease-in-out infinite;
}

/* Info bar */
.hero-infobar {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  z-index: 3;
  display: flex;
  align-items: stretch;
  border-top: 1px solid rgba(255,255,255,0.08);
  background: rgba(16,14,11,0.6);
  backdrop-filter: blur(12px);
  animation: fadeUp 1s ease 1.4s both;
}
.ib-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 1rem 1.5rem;
}
.ib-label {
  font-size: 0.6rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.6);
  margin-bottom: 0.25rem;
}
.ib-val { font-size: 0.82rem; color: rgba(255,255,255,0.75); }
.ib-sep { width: 1px; background: rgba(255,255,255,0.08); margin: 0.75rem 0; }

@keyframes bgZoom { to { transform: scale(1); } }
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: none; }
}
@keyframes scrollAnim {
  0%  { top: -100%; opacity: 1; }
  80% { top: 100%; opacity: 1; }
  81% { opacity: 0; top: 100%; }
  82% { top: -100%; opacity: 0; }
  100%{ top: -100%; opacity: 0; }
}
@media (max-width: 768px) {
  .hero-infobar { display: none; }
  .hero-content { padding-bottom: 7rem; }
  .hero-scroll-ind { display: none; }
}
@media (max-width: 400px) {
  .tl { font-size: clamp(2.6rem, 13vw, 3.5rem); }
  .tl-thin { font-size: 1.4rem; }
  .hero-pills { gap: 0.5rem; }
  .pill-div { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-bg :global(img), .tl, .hero-eyebrow, .hero-desc, .hero-pills, .cta-btn,
  .hero-scroll-ind, .hero-infobar, .scroll-thumb { animation: none !important; }
  .hero-bg :global(img) { transform: none; }
}
</style>
