---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Tentang from '../components/Tentang.astro';
import Tappareng from '../components/Tappareng.astro';
import HasilBumi from '../components/HasilBumi.astro';
import Rundown from '../components/Rundown.astro';
import Mappadendang from '../components/Mappadendang.astro';
import Mappere from '../components/Mappere.astro';
import Olahraga from '../components/Olahraga.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
---

<Layout>
  <MusicPlayer />
  <Navbar />
  <main id="main-content">
    <Hero />
    <Tentang />
    <Tappareng />
    <HasilBumi />
    <Rundown />
    <Mappadendang />
    <Mappere />
    <Olahraga />
  </main>
  <Footer />
</Layout>

